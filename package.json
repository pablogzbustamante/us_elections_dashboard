{
  "name": "elections-dashboard",
  "private": true,
  "scripts": {
    "dev":   "npm run db:up && node scripts/wait-for-db.js && node scripts/ensure-data.js && concurrently --names \"API,UI\" --prefix-colors \"red.bold,cyan.bold\" \"npm run api\" \"npm run ui\"",
    "db":    "docker compose up db",
    "db:up": "docker compose up -d db",
    "api":   "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "ui":    "npm --prefix frontend run dev",
    "etl":   "cd backend && python etl/load.py",
    "setup": "npm install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
